<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Application Theme -->
    <style name="Theme.KidsEnglishApp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFFDFBF7</item>
    </style>

    <!-- Native AndroidX SplashScreen Theme for seamless handoff to Compose Splash UI -->
    <style name="Theme.KidsEnglishApp.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFE0F7FA</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_app_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.KidsEnglishApp</item>
    </style>
</resources>
